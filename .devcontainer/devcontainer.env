# Copy to .devcontainer/.env (gitignored) and fill in secrets.

# One Password Connect
OP_CONNECT_HOST=https://op-connect.local.abbottland.io
OP_CONNECT_TOKEN=

# Docker Registry
DOCKER_REGISTRY=harbor.local.abbottland.io
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Skaffold Configuration
SKAFFOLD_DEFAULT_REPO=harbor.local.abbottland.io/dev

# Node Environment
NODE_ENV=development

# Claude Code
# DISABLED for now (see TOGGLES.md); uncomment when needed
# CLAUDE_CODE_OAUTH_TOKEN=
