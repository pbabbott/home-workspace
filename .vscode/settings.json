{
  // Nested repos are gitignored by the outer repo and cloned by scripts/repos.sh;
  // list them explicitly so VS Code's Source Control finds them on every start.
  "git.scanRepositories": [
    "/workspaces/home-workspace/home-web-apps",
    "/workspaces/home-workspace/home-playbooks",
    "/workspaces/home-workspace/home-kubernetes"
  ],
  // Keep huge generated dirs out of file watching and search.
  "files.watcherExclude": {
    "**/.pnpm-store/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.pnpm-store": true,
    "**/node_modules": true
  }
}
